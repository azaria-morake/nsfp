    "password2": "SecurePass123!",
    "location": "Johannesburg"
  }'

# Login credentials
curl -X POST http://localhost:8000/api/login/ \
  -H "Content-Type: application/json" \
  -d '{"username": "lion_team", "password": "SecurePass123!"}'


# Lofout 
curl -X POST http://localhost:8000/api/logout/ \
  -H "Authorization: Token YOUR_TOKEN_HERE"

# Refresh token
curl -X POST http://localhost:8000/api/token/refresh/ \
  -H "Authorization: Token abc123" \
  -H "Content-Type: application/json"

# Test if token is active
curl -H "Authorization: Token abc123" http://localhost:8000/api/teams/me/


# Get current profile
curl -H "Authorization: Token YOUR_TOKEN" http://localhost:8000/api/profile/

# Update location
curl -X PATCH -H "Authorization: Token YOUR_TOKEN" \
  -H "Content-Type: application/json" \
  -d '{"location": "Cape Town"}' \
  http://localhost:8000/api/profile/

# Try invalid email
curl -X PATCH -H "Authorization: Token YOUR_TOKEN" \
  -H "Content-Type: application/json" \
  -d '{"email": "invalid-email"}' \
  http://localhost:8000/api/profile/


# Password change
curl -X POST -H "Authorization: Token YOUR_TOKEN" \
  -H "Content-Type: application/json" \
  -d '{"old_password": "old_pass", "new_password": "NewSecure123!", "confirm_password": "NewSecure123!"}' \
  http://localhost:8000/api/change-password/

# Mismatched passwords
curl -X POST -H "Authorization: Token YOUR_TOKEN" \
  -H "Content-Type: application/json" \
  -d '{"old_password": "old_pass", "new_password": "NewSecure123!", "confirm_password": "Different123!"}' \
  http://localhost:8000/api/change-password/

# Upload photo
curl -X POST -H "Authorization: Token YOUR_TOKEN" \
  -F "image=@/path/to/photo.jpg" \
  http://localhost:8000/api/photos/

